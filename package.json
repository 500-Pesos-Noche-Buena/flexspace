{
  "name": "flexspace",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "client": "npm run dev --prefix client -- --host",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue,bgMagenta\" \"nodemon server/server.js\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue,bgMagenta\" \"nodemon server/server.js\" \"npm run client\"",
    "test": "node test.js",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:strict": "node test.js --require-full-coverage"
  },
  "keywords": [],
  "author": "Josiah",
  "license": "ISC",
  "description": "Geolocation-based co-working space finder for Iloilo City",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "concurrently": "^9.2.1"
  }
}
