NODE_ENV=development
PORT=5000
VITE_API_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

INTERNAL_API_KEY=your_internal_api_key_here

# Security
JWT_SECRET=your_jwt_secret_here
BCRYPT_SALT_ROUNDS=10

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=co_working

# Vercel Configuration
VERCEL_API_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_team_id_here
VERCEL_PROJECT_ID=your_project_id_here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_secret_here

# Queue Settings
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Session Secret (for passport)
SESSION_SECRET=your_session_secret_here

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_here

# Blog Generation API Key
BLOG_API_KEY=your_blog_api_key_here

# PayBridge Configuration
PAYBRIDGE_API_URL=https://paybridge-ph.vercel.app/api/v1
PAYBRIDGE_MASTER_KEY=your_paybridge_master_key_here